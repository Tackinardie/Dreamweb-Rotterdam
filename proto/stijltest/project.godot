; Wegwerpproject voor de stijltest (issue #32). Niet het spelproject.
config_version=5

[application]

config/name="Onderstad stijltest"
run/main_scene="res://a_straat.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
renderer/rendering_method="forward_plus"
